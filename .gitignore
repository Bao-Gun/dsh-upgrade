node_modules/
# 安装脚本只在 --apply 时同步 profile 的锁文件；仓库自身的依赖锁不入库
package-lock.json
__pycache__/
.venv/
dist/
# git 源安装只拿这个 commit 的 tar、不跑构建：产物 js 必须入库，sourcemap 不必
/lib/*
!/lib/*.js
build/
.env
.env.*
*.local
.DS_Store

# agent 的草稿、计划、临时分析，不进 git
.work/

# superpowers 的临时 mockup（.superpowers/sdd/ 会自己忽略）
.superpowers/brainstorm/

# 并行开发的工作树（using-git-worktrees 要求它必须已忽略）
.worktrees/
